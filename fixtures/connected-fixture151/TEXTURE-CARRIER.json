  "turns": [
    {
      "semantic_turn_id": "estuary109_t01",
      "sequence": 1,
      "program_block_id": "6d50514e-bb43-5b2b-a565-9e25d58d7f0c",
      "participant_id": "nia_calder",
      "spoken_text": "Imagine a touchline umbrella with a handle so large that nobody can grip it. That seems an ambitious way to stay dry."
    },
    {
      "semantic_turn_id": "estuary109_t02",
      "sequence": 2,
      "program_block_id": "6d50514e-bb43-5b2b-a565-9e25d58d7f0c",
      "participant_id": "jonah_reed",
      "spoken_text": "I'd choose the ordinary handle."
    },
    {
      "semantic_turn_id": "estuary109_t03",
      "sequence": 3,
      "program_block_id": "2d59c16c-e9b0-53ff-8ee0-88c11ba827bd",
      "participant_id": "mara_ives",
      "spoken_text": "Back to Bellhaven Athletic. This is an entirely fictional football evaluation."
    },
    {
      "semantic_turn_id": "estuary109_t04",
      "sequence": 4,
      "program_block_id": "09b1aad1-7ae2-56c9-9741-b3e578c4d5ce",
      "participant_id": "mara_ives",
      "spoken_text": "The fictional ledger records a Bellhaven Athletic win over Quartz Vale."
    },
    {
      "semantic_turn_id": "estuary109_t05",
      "sequence": 5,
      "program_block_id": "09b1aad1-7ae2-56c9-9741-b3e578c4d5ce",
      "participant_id": "jonah_reed",
      "spoken_text": "The fictional ledger records two late concessions in five selected completed cup matches. That window is a description, not a diagnosis."
    },
    {
      "semantic_turn_id": "estuary109_t06",
      "sequence": 6,
      "program_block_id": "cd755392-009f-51eb-a97c-acfa29cfeaa7",
      "participant_id": "mara_ives",
      "spoken_text": "The fictional training note says 'Leave the centre covered.' The near midfielder is asked to stay central while a teammate contests the second ball."
    },
    {
      "semantic_turn_id": "estuary109_t07",
      "sequence": 7,
      "program_block_id": "cd755392-009f-51eb-a97c-acfa29cfeaa7",
      "participant_id": "jonah_reed",
      "spoken_text": "The fictional ledger describes excerpt R: the near midfielder stays central; the opponent collects the loose ball but makes no central pass. In excerpt S, the midfielder moves towards the second ball and an opponent passes through the vacated lane."
    },
    {
      "semantic_turn_id": "estuary109_t08",
      "sequence": 8,
      "program_block_id": "cd755392-009f-51eb-a97c-acfa29cfeaa7",
      "participant_id": "nia_calder",
      "spoken_text": "What can that comparison establish?"
    },
    {
      "semantic_turn_id": "estuary109_t09",
      "sequence": 9,
      "program_block_id": "cd755392-009f-51eb-a97c-acfa29cfeaa7",
      "participant_id": "jonah_reed",
      "spoken_text": "The fictional ledger gives us central cover in R and a vacated lane in S. The fictional training note asks for central cover. R illustrates compliance with that instruction and S illustrates departure, but these excerpts alone do not establish what caused either outcome."
    },
    {
      "semantic_turn_id": "estuary109_t10",
      "sequence": 10,
      "program_block_id": "cd755392-009f-51eb-a97c-acfa29cfeaa7",
      "participant_id": "jonah_reed",
      "spoken_text": "The fictional Estuary Analyst suggests fatigue could explain a late retreat. That remains a hypothesis, separate from the positioning comparison."
    },
    {
      "semantic_turn_id": "estuary109_t11",
      "sequence": 11,
      "program_block_id": "02adc00e-063d-5e29-bd01-466a2c260b0d",
      "participant_id": "mara_ives",
      "spoken_text": "The fictional ledger therefore leaves us with a concrete difference in positioning, not a general explanation for the result."
    },
    {
      "semantic_turn_id": "estuary109_t12",
      "sequence": 12,
      "program_block_id": "844de2ac-6bbf-57aa-a558-bd6df22e3747",
      "participant_id": "nia_calder",
      "spoken_text": "The fictional ledger records relief in the selected supporter notes, with worry about the final clearance in Pella's note. I can understand that mixed reaction without calling it a whole crowd speaking."
    },
    {
      "semantic_turn_id": "estuary109_t13",
      "sequence": 13,
      "program_block_id": "844de2ac-6bbf-57aa-a558-bd6df22e3747",
      "participant_id": "mara_ives",
      "spoken_text": "The fictional pamphlet calls a hurried clearance 'a borrowed breath'."
    },
    {
      "semantic_turn_id": "estuary109_t14",
      "sequence": 14,
      "program_block_id": "844de2ac-6bbf-57aa-a558-bd6df22e3747",
      "participant_id": "jonah_reed",
      "spoken_text": "A useful image; it is not a measurement."
    },
    {
      "semantic_turn_id": "estuary109_t15",
      "sequence": 15,
      "program_block_id": "f8ca0b87-0aee-5820-8095-18db9c5af17e",
      "participant_id": "mara_ives",
      "spoken_text": "The fictional ledger contrasts R, where the near midfielder stays central, with S, where that player follows the second ball and the lane is used. The fictional training note asks for central cover. Keep that specific contrast; the cause remains open."
    },
    {
      "semantic_turn_id": "estuary109_t16",
      "sequence": 16,
      "program_block_id": "2cda05cf-b36f-5dcb-b321-94fe9061fbf5",
      "participant_id": "mara_ives",
      "spoken_text": "If a later fictional instruction asks for central cover, I expect checking that lane to be a useful first question."
    },
    {
      "semantic_turn_id": "estuary109_t17",
      "sequence": 17,
      "program_block_id": "2cda05cf-b36f-5dcb-b321-94fe9061fbf5",
      "participant_id": "jonah_reed",
      "spoken_text": "If a later fictional report proposes a cause, I expect the quality of its measurements to matter more than its confidence."
    },
    {
      "semantic_turn_id": "estuary109_t18",
      "sequence": 18,
      "program_block_id": "2cda05cf-b36f-5dcb-b321-94fe9061fbf5",
      "participant_id": "nia_calder",
      "spoken_text": "If a later fictional supporter note sounds relieved, I expect to keep reading for whatever concern accompanies it."
    },
    {
      "semantic_turn_id": "estuary109_t19",
      "sequence": 19,
      "program_block_id": "21e7afe3-7ff1-5afe-895a-ce93e04ba27c",
      "participant_id": "mara_ives",
      "spoken_text": "That closes this fictional discussion. No real match or performed timing has been established."
    }
  ],
