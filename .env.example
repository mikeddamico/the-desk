# Explicit environment identity is required. Never infer production.
DESK_ENV=development
DATABASE_URL=postgresql://desk_runtime:local_only@localhost:5432/the_desk
MIGRATION_DATABASE_URL=postgresql://desk_migrator:local_only@localhost:5432/the_desk
DEPLOYED_COMMIT=local
PROVIDERS_ENABLED=false
GENERATION_KILL_SWITCH=true
LOG_LEVEL=info
ERROR_TRACKING_DSN=
