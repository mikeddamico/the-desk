{
  "name": "the-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": "11.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run --exclude 'test/integration/**'",
    "test:integration": "vitest run test/integration",
    "test:all": "vitest run",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:verify": "tsx src/db/cli.ts verify",
    "db:load-fixture": "tsx src/db/cli.ts load-fixture",
    "fixture:reenter": "tsx src/cli/fixture-reentry.ts",
    "db:reset": "tsx src/db/cli.ts reset",
    "program:attempt": "tsx src/cli/program-attempt.ts",
    "review:wait": "tsx src/cli/review-wait.ts"
  },
  "dependencies": {
    "pg": "8.16.3",
    "pino": "9.9.5",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.5.2",
    "@types/pg": "8.15.5",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.70.1",
    "vitest": "4.1.11"
  },
  "packageManager": "npm@11.19.0"
}
