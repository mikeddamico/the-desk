{
  "name": "the-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run --exclude 'test/integration/**'",
    "test:integration": "vitest run test/integration",
    "test:all": "vitest run",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:verify": "tsx src/db/cli.ts verify",
    "db:reset": "tsx src/db/cli.ts reset"
  },
  "dependencies": {
    "pg": "8.16.3",
    "pino": "9.9.5",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@types/node": "24.5.2",
    "@types/pg": "8.15.5",
    "eslint": "9.36.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vitest": "4.1.11"
  }
}
